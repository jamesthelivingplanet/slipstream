<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify"
        />

        <!-- FLO-160: receives data-only "slipstreamSummary" FCM messages and
             maintains the always-visible ongoing notification. Does NOT handle
             per-session notifications (those carry an FCM `notification` block
             and are auto-displayed by FCM in the background / dispatched by the
             Capacitor push-notifications plugin in the foreground).

             Coexistence with @capacitor/push-notifications: that plugin also
             registers a FirebaseMessagingService for MESSAGING_EVENT. Android
             delivers each FCM message to exactly one such service, resolved by
             intent-filter priority (ties broken by manifest declaration order).
             Firebase's own base service declares priority -500; the plugin's
             uses the default 0. android:priority="1" here makes THIS service
             win deterministically so the ongoing notification reliably appears.
             onMessageReceived early-returns for anything that is not a summary,
             so non-summary data-only messages are dropped here (the app uses no
             other data-only messages). Per-session notification messages carry
             an FCM `notification` block, so they are auto-displayed by the
             system in the background independent of any service; in the
             foreground they reach this service's early-return, which is a no-op
             because the app registers no 'pushNotificationReceived' JS listener.
             Because this service wins, it also owns onNewToken and forwards it
             to PushNotificationsPlugin so FCM token rotation still re-saves the
             token server-side. No functional regression for the existing push
             flow. -->
        <service
            android:name=".SlipstreamMessagingService"
            android:exported="false">
            <intent-filter android:priority="1">
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- TASK-DM25C: home-screen agent-status widget -->
        <receiver
            android:name=".AgentWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_agents_info" />
        </receiver>

        <service
            android:name=".AgentWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13+ (API 33) requires this to show push notifications; the
         @capacitor/push-notifications plugin requests it at runtime but does not
         declare it in its own manifest, so it must be declared here. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
