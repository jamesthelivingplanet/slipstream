# Fastfile — iOS build/sign/ship lanes for Slipstream (FLO-149).
#
# Signing strategy: App Store Connect API key + Xcode AUTOMATIC signing, not
# `match`. `match` wins when multiple machines/engineers need the same
# certs+profiles reproducibly (it stores them, encrypted, in a separate git
# repo). Slipstream's iOS builds run from exactly one place — Codemagic, using
# a single App Store Connect API key — so there's no second machine to keep in
# sync and no Matchfile/cert-repo to provision and rotate. `build_app` with
# Xcode's own "Automatically manage signing" (set on the App target) plus an
# authenticated `api_key` session lets Xcode mint/renew the distribution cert
# and provisioning profile itself on every CI run. If a second build machine
# or a second engineer ever needs to sign locally, switch this file to `match`
# + `sync_code_signing` and add a `Matchfile` pointing at a private certs repo
# — don't hand-roll a second manual-signing path alongside this one.
default_platform(:ios)

platform :ios do
  # ---------------------------------------------------------------------
  # setup_ci_signing (private) — authenticate with an App Store Connect API
  # key from env so lanes never need an interactive Apple ID login/2FA
  # prompt. Required env (see docs/MOBILE-IOS.md for where each comes from):
  #   APP_STORE_CONNECT_KEY_ID        — the key's Key ID (App Store Connect →
  #                                      Users and Access → Keys)
  #   APP_STORE_CONNECT_ISSUER_ID     — the Issuer ID on that same Keys page
  #   APP_STORE_CONNECT_PRIVATE_KEY   — the .p8 key's contents (the whole
  #                                      file, PEM headers included)
  # ---------------------------------------------------------------------
  private_lane :setup_ci_signing do
    app_store_connect_api_key(
      key_id: ENV.fetch('APP_STORE_CONNECT_KEY_ID'),
      issuer_id: ENV.fetch('APP_STORE_CONNECT_ISSUER_ID'),
      key_content: ENV.fetch('APP_STORE_CONNECT_PRIVATE_KEY'),
      is_key_content_base64: false
    )
  end

  # ---------------------------------------------------------------------
  # Shared build step for beta/release: pod install, bump the build number,
  # produce a Release .ipa signed for app-store distribution. Returns
  # nothing — both lanes just need the .ipa build_app leaves in place for
  # the upload step that follows.
  # ---------------------------------------------------------------------
  private_lane :build_release_ipa do
    cocoapods(podfile: 'ios/App/Podfile')

    build_number = ENV['BUILD_NUMBER'] || (latest_testflight_build_number(
      app_identifier: 'app.slipstream.mobile'
    ) + 1).to_s
    increment_build_number(
      build_number: build_number,
      xcodeproj: 'ios/App/App.xcodeproj'
    )

    # FLO-149: DEVELOPMENT_TEAM is deliberately not committed in the pbxproj
    # (it's an account identifier), so inject it from CI env here — automatic
    # signing can't resolve a team otherwise.
    update_code_signing_settings(
      path: 'ios/App/App.xcodeproj',
      use_automatic_signing: true,
      team_id: ENV.fetch('APPLE_TEAM_ID')
    )

    build_app(
      workspace: 'ios/App/App.xcworkspace',
      scheme: 'App',
      configuration: 'Release',
      export_method: 'app-store',
      # FLO-149: without -allowProvisioningUpdates, xcodebuild won't let Xcode
      # mint/renew the distribution cert + profile non-interactively — the
      # whole premise of the API-key + automatic-signing strategy above.
      xcargs: '-allowProvisioningUpdates'
    )
  end

  # ---------------------------------------------------------------------
  # beta — build and push to TestFlight. Does not wait for Apple's
  # (usually few-minutes) processing step to finish; TestFlight internal
  # testers can install as soon as processing completes on Apple's side
  # regardless.
  # ---------------------------------------------------------------------
  desc 'Build and upload a Release build to TestFlight'
  lane :beta do
    setup_ci_signing
    build_release_ipa
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      app_identifier: 'app.slipstream.mobile'
    )
  end

  # ---------------------------------------------------------------------
  # release — build and submit to App Store review. Manual release
  # (automatic_release left off/false) so James decides when the approved
  # build actually goes live. `run_precheck_before_submit: false` disables
  # deliver's pre-submit metadata lint (App Store Connect description,
  # keywords, screenshots) — that content lives in App Store Connect
  # itself, not in this repo, and `skip_metadata`/`skip_screenshots` below
  # mean deliver never touches it, so there's nothing here for precheck to
  # check.
  # ---------------------------------------------------------------------
  desc 'Build and submit a Release build for App Store review'
  lane :release do
    setup_ci_signing
    build_release_ipa
    upload_to_app_store(
      app_identifier: 'app.slipstream.mobile',
      submit_for_review: true,
      automatic_release: false,
      run_precheck_before_submit: false,
      skip_metadata: true,
      skip_screenshots: true,
      force: true
    )
  end
end
